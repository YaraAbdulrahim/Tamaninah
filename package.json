{
  "name": "tumanina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "snapshot:quran": "vite-node server/scripts/snapshotQuran.ts",
    "eval": "vite-node server/scripts/evalSafetyCases.ts",
    "e2e": "playwright test",
    "e2e:live": "cross-env E2E_LIVE=1 playwright test",
    "snapshot:content": "vite-node server/scripts/snapshotContent.ts",
    "verify:content": "vite-node server/scripts/snapshotContent.ts --verify",
    "snapshot:lessons": "vite-node server/scripts/snapshotLessons.ts",
    "verify:lessons": "vite-node server/scripts/snapshotLessons.ts --verify"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
