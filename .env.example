# Server-only. Never prefix with VITE_ — that would ship the key to the browser.
# Local dev reads this file (via `npm run dev`); on Netlify set the same names in the UI or with
# `netlify env:set` (scope: Functions). netlify.toml variables do NOT reach functions.

# Google AI Studio key via Gemini's OpenAI-compatible endpoint (any OpenAI-compatible API works).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Ordered fallback list. On 404 (retired) / 429 / 5xx (e.g. 503 "high demand") the next model starts
# at once; if a model is merely slow, the next one starts after AI_HEDGE_AFTER_MS and the first
# answer wins. Everything — fallbacks, retries, JSON repair — shares one 18 s analyze deadline.
AI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Sent as `reasoning_effort` only when set — set it to low for Gemini (keeps the analyze stage fast).
# Leave it unset (or "none") for models without reasoning support, e.g. gpt-4o-mini.
# A model that answers 400 to it is retried once without it.
AI_REASONING_EFFORT=low

# Optional tuning (milliseconds).
# AI_DEADLINE_MS=18000         # whole analyze stage; keep under the function time budget
# AI_HEDGE_AFTER_MS=2500       # start the next model if the current one is still silent

# Opt-in local fallback only. Never the product.
# Without AI_API_KEY the API returns unconfigured — it will not invent an answer.
# Set AI_MOCK=true only for tests or offline UI work.
AI_MOCK=false

# Dev/preview only: also refresh Quran items live from Quranpedia at server start.
# Not needed — the committed snapshot (npm run snapshot:quran) is always loaded.
# QURAN_LIVE_WARM=false

# Accepted as aliases if you already have OpenAI-named variables:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
